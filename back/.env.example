# ─────────────────────────────────────────────────────────────────────────
# MyReviewer — environment configuration
# Copy this file to `.env` and fill in your values. The `.env` file is
# gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────

# ── LLM provider: NVIDIA NIM (free hosted OpenAI-compatible endpoints) ────
# Get a free key at https://build.nvidia.com → "API keys" (format: nvapi-...)
# The pipeline runs real LLM calls whenever this is set. Leave it empty and
# the API fails fast with a clear message — mock responses are an explicit
# dev/test opt-in only (the dashboard's mock checkbox).
NIM_API_KEY=

# Leave as-is unless you self-host a NIM / vLLM server (base URL must end in /v1)
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Default model. We start with a single model; add others deliberately from the
# NVIDIA NIM catalog by hardcoding them in NIM_MODELS (comma-separated).
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional: extra model ids offered in the dashboard model selector
# (comma-separated; self-hosted vLLM/NIM or account-specific models).
#NIM_MODELS=

# Optional sampling controls
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=8192

# ── Phase 3: "Connect your GitHub" (OAuth App) — dashboard flow ─────────────
# 1. Create an OAuth App at https://github.com/settings/developers/apps
#    Homepage URL: https://myreviewer.tech
#    Callback URL: https://myreviewer.tech/api/auth/callback
# 2. Paste the client id + secret below. The dashboard then shows a
#    "Connect GitHub" button — no PR URL pasting, and analysis uses YOUR token.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
#GITHUB_REDIRECT_URI=https://myreviewer.tech/api/auth/callback

# ── Local development GitHub OAuth App ──────────────────────────────────────
# GitHub allows EXACTLY ONE callback URL per OAuth App, so local dev uses a
# SEPARATE OAuth App (create it at github.com/settings/developers/apps with
# Callback URL http://localhost:8000/api/auth/callback). The backend picks the
# right client automatically from the request Host header — on localhost it
# uses GITHUB_DEV_*, on the VM it uses GITHUB_* above. No code changes needed
# to switch environments.
#GITHUB_DEV_CLIENT_ID=
#GITHUB_DEV_CLIENT_SECRET=
#GITHUB_DEV_REDIRECT_URI=http://localhost:8000/api/auth/callback

# ── Deployment (Azure VM / App Service)──────────────────────────────────────
# Public URL of the deployed app. Used for OAuth redirect targets and the
# post-login redirect. Falls back to VERCEL_URL, then to the production domain.
#APP_URL=https://myreviewer.tech
#
# Writable directory for runtime data (users/sessions/reports/oauth state).
# Vercel's filesystem is read-only except /tmp, so point this at ${DATA_DIR:-/tmp}:
#DATA_DIR=/tmp/myreviewer-data

# ── Phase 2: GitHub access (required for the webhook + PR listing) ─────────
# A Personal Access Token (PAT) with `repo` scope. The webhook uses this token
# to fetch diffs and post/update the review comment on `pull_request` events.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
#
# ── GitHub App webhook server (github_app/app.py, served at /webhook) ───────
# Register the webhook URL as https://myreviewer.tech/webhook on your GitHub
# App and enable the `pull_request` event. With GITHUB_APP_ENABLED=0 the
# /webhook endpoint is inert and just logs events.
GITHUB_APP_ENABLED=1
#GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_BOT_USERNAME=myreviewer[bot]
#GITHUB_PRIVATE_KEY_PATH=path/to/private-key.pem